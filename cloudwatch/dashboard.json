    {
      "type": "metric",
      "x": 0,
      "y": 15,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "EC2 Status Check Results",
        "view": "timeSeries",
        "stacked": false,
        "metrics": [
          [
            "AWS/EC2",
            "StatusCheckFailed_Instance",
            "InstanceId",
            "INSTANCE_ID",
            {
              "label": "Instance Status Check",
              "color": "#d62728",
              "stat": "Maximum",
              "period": 60
            }
          ],
          [
            "AWS/EC2",
            "StatusCheckFailed_System",
            "InstanceId",
            "INSTANCE_ID",
            {
              "label": "System Status Check",
              "color": "#ff9896",
              "stat": "Maximum",
              "period": 60
            }
          ]
        ],
        "yAxis": {
          "left": {
            "min": 0,
            "max": 1,
