    {
      "type": "metric",
      "x": 12,
      "y": 9,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "Network I/O (bytes/min)",
        "view": "timeSeries",
        "stacked": false,
        "metrics": [
          [
            "CWAgent",
            "net_bytes_recv",
            "InstanceId",
            "INSTANCE_ID",
