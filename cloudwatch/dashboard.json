{
  "widgets": [
    {
      "type": "text",
      "x": 0,
      "y": 0,
      "width": 24,
      "height": 1,
      "properties": {
        "markdown": "# EC2 Monitoring Dashboard — Automated Cloud Monitoring & Recovery System\nReal-time view of CPU, memory, disk, and network metrics. Alarm states shown below."
      }
    },
    {
      "type": "alarm",
      "x": 0,
      "y": 1,
      "width": 24,
      "height": 2,
      "properties": {
        "title": "Alarm Status Overview",
        "alarms": [
          "arn:aws:cloudwatch:REGION:ACCOUNT_ID:alarm:HighCPUUtilization-INSTANCE_ID",
          "arn:aws:cloudwatch:REGION:ACCOUNT_ID:alarm:HighMemoryUtilization-INSTANCE_ID",
          "arn:aws:cloudwatch:REGION:ACCOUNT_ID:alarm:HighDiskUtilization-INSTANCE_ID",
          "arn:aws:cloudwatch:REGION:ACCOUNT_ID:alarm:EC2StatusCheckFailed-INSTANCE_ID",
          "arn:aws:cloudwatch:REGION:ACCOUNT_ID:alarm:CloudWatchAgentHeartbeatMissing-INSTANCE_ID"
        ]
      }
    },
    {
      "type": "metric",
      "x": 0,
      "y": 3,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "CPU Utilization (%)",
        "view": "timeSeries",
        "stacked": false,
        "metrics": [
          [
            "AWS/EC2",
            "CPUUtilization",
            "InstanceId",
            "INSTANCE_ID",
            {
              "label": "CPU Utilization",
              "color": "#ff7f0e",
              "stat": "Average",
              "period": 60
            }
          ]
        ],
        "yAxis": {
          "left": {
            "min": 0,
            "max": 100,
            "label": "Percent"
          }
        },
        "annotations": {
          "horizontal": [
            {
              "label": "Alarm threshold (90%)",
              "value": 90,
              "color": "#d62728"
            }
          ]
        },
        "period": 60,
        "stat": "Average",
        "region": "REGION",
        "start": "-PT3H",
        "end": "P0D"
      }
    },
    {
      "type": "metric",
      "x": 12,
      "y": 3,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "Memory Utilization (%)",
